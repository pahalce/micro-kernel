  "license": "ISC",
  "dependencies": {
    "@arch/microkernel-pay-sdk": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@shared/tsconfig-base": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  }
