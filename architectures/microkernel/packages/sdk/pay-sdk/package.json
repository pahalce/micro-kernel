{
  "name": "@arch/microkernel-pay-sdk",
  "version": "1.0.0",
  "description": "マイクロカーネルアーキテクチャに基づく決済システムSDK",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./plugins": "./dist/plugins/index.js"
  },
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json",
    "lint": "biome lint --write **/*.ts",
    "format": "biome format --write **/*.ts",
    "check": "biome check --write **/*.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["payment", "sdk", "micro-kernel"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@shared/tsconfig-base": "workspace:*",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  }
}
