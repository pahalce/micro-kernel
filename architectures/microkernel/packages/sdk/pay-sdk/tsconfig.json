{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@shared/tsconfig-base/tsconfig.lib.json",
  "compilerOptions": {
    "target": "es2020", // ES2017 以上なら OK。node16 環境向けに es2020 推奨
    "rootDir": "src", // ルートディレクトリ
    "declarationDir": "dist", // 型定義ファイルの出力先
    "outDir": "dist" // JavaScriptファイルの出力先
  },
  "include": ["src"]
}
